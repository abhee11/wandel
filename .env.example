# Copy values into .env locally. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: development only; defaults to actual OpenAI if omitted.
# WANDEL_AI_MODE=mock
WANDEL_APP_ORIGIN=http://127.0.0.1:5174
WANDEL_PORT=4320
WANDEL_DB=.data/wandel.sqlite
WANDEL_PRO_PRICE_CENTS=1500
# Legacy mock billing is used only by isolated tests, never the running server.
WANDEL_MOCK_BILLING=false
# Required in production, at least 32 unpredictable characters.
SESSION_PEPPER=
# Comma-separated exact extension origins; no wildcard.
WANDEL_EXTENSION_ORIGINS=
# Legacy-auth-only reset-email delivery: POST {template,to,resetUrl}, bearer authentication.
WANDEL_MAIL_WEBHOOK=
WANDEL_MAIL_TOKEN=
# Optional full override; null means no commercial count limit.
# WANDEL_PLAN_LIMITS={"FREE":{"savedWorkflows":3,"aiActionsPerMonth":20,"maxDepth":5,"savedVersions":3,"versionHistory":false,"privateSharing":false},"PRO":{"savedWorkflows":null,"aiActionsPerMonth":500,"maxDepth":null,"savedVersions":null,"versionHistory":true,"privateSharing":false}}

# Clerk is the default auth provider. Enable Google in the Clerk dashboard.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SYNC_HOST=http://127.0.0.1
WANDEL_AUTH_MODE=clerk
WANDEL_API_ORIGIN=http://127.0.0.1:4320
# Optional stable CRX public key. Never put a private signing key here.
WANDEL_EXTENSION_KEY=
# Set WANDEL_EXTENSION_ORIGINS above to chrome-extension://<your-extension-id>.

# Stripe SANDBOX / TEST credentials only. Live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
